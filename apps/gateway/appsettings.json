{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Keycloak": {
      "Realm": "roomy",
      "ClientId": "roomy-bff",
      "RequireHttpsMetadata": true
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-account": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/account/{**catch-all}"
        }
      },
      "identity-admin": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/admin/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "identity-api": {
            "Address": "http://identity-api"
          }
        }
      }
    }
  }
}
