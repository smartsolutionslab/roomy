<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartSolutionsLab.Roomy.Gateway.Tests</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Gateway.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      These are pure unit tests over the gateway's token-free projection helpers (realm-role
      flattening, the SPA CurrentUser mapping). They run without a live identity provider. The
      genuine end-to-end OIDC login flow needs a real Keycloak, which the Docker-less CI cannot
      provide; that round-trip is deferred to a Testcontainers/Aspire test (follow-up to #21).
    -->
    <ProjectReference Include="../Roomy.Gateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
