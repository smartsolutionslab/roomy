<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SmartSolutionsLab.Roomy.Organization.Api</RootNamespace>
    <AssemblyName>Roomy.Organization.Api</AssemblyName>
    <!--
      The typed Angular client is generated from a committed OpenAPI spec (ADR-0018/0036). The
      spec is emitted next to the host. Emitting boots the host to resolve the document, and the
      host throws without its connection strings/Keycloak config, so the emit is NOT part of the
      ordinary build (that would force every `dotnet build` to carry dummy config). Instead it is a
      deliberate step that supplies dummy config — exactly like the Wolverine codegen step
      (ADR-0034). CI re-runs it and fails if the committed spec drifts.
    -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The organization context host (ADR-0014). Composition root: wires the EF Core persistence and the
      JWT-bearer authorization of the BFF-forwarded token, and exposes the office/room admin surface.
      No messaging adapter — this slice publishes and consumes nothing (research.md D4).
    -->
    <ProjectReference Include="../../libs/service-defaults/Roomy.ServiceDefaults.csproj" />
    <ProjectReference Include="../../libs/organization/infrastructure/Roomy.Organization.Infrastructure.csproj" />
    <!-- The Wolverine messaging backbone (ADR-0005): the transactional outbox that relays the office/room
         integration events over RabbitMQ (publish-only — this context consumes nothing). -->
    <ProjectReference Include="../../libs/infrastructure-messaging/src/Roomy.Infrastructure.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validates the BFF-forwarded Keycloak access token as a JWT bearer (ADR-0013). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <!-- Publishes the OpenAPI document the typed Angular client is generated from (ADR-0018/0036). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <!-- Build-time `GetDocument` emit of the static spec to OpenApiDocumentsDirectory (ADR-0036). -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core design-time tooling: used only by `dotnet ef` against the design-time factory. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
