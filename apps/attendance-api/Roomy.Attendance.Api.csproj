<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>SmartSolutionsLab.Roomy.Attendance.Api</RootNamespace>
    <AssemblyName>Roomy.Attendance.Api</AssemblyName>
    <!--
      The typed Angular client is generated from a committed OpenAPI spec (ADR-0018/0036). The
      spec is emitted next to the host. Emitting boots the host to resolve the document, and the
      host throws without its connection strings/Keycloak config, so the emit is NOT part of the
      ordinary build (that would force every `dotnet build` to carry dummy config). Instead it is a
      deliberate step that supplies dummy config — exactly like the Wolverine codegen step
      (ADR-0034). CI re-runs it and fails if the committed spec drifts.
    -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The attendance context host (ADR-0014): the composition root. It wires the event-sourced
      persistence (ADR-0012) behind the shared service defaults and exposes the reservation surface.
      No messaging yet — US1 has no consumers or publishers; the capacity/employee feeds arrive in
      US2/US4.
    -->
    <ProjectReference Include="../../libs/service-defaults/Roomy.ServiceDefaults.csproj" />
    <ProjectReference Include="../../libs/attendance/infrastructure/Roomy.Attendance.Infrastructure.csproj" />
    <!-- The Wolverine messaging backbone (ADR-0005): the durable inbox that consumes organization's
         RoomAdded into the Rooms read model (003 US2). -->
    <ProjectReference Include="../../libs/infrastructure-messaging/src/Roomy.Infrastructure.Messaging.csproj" />
    <ProjectReference Include="..\..\libs\infrastructure-authentication\src\Roomy.Infrastructure.Authentication.csproj" />
    <ProjectReference Include="..\..\libs\web-http\src\Roomy.Web.Http.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Validates the BFF-forwarded Keycloak access token as a JWT bearer (ADR-0013). -->
    <!-- Publishes the OpenAPI document the typed Angular client is generated from (ADR-0018/0036). -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <!-- Build-time `GetDocument` emit of the static spec to OpenApiDocumentsDirectory (ADR-0036). -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core design-time tooling: used only by `dotnet ef` against the design-time factory. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
