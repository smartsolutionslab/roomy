<Project Sdk="Aspire.AppHost.Sdk/13.4.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>b3cfe2eb-679c-4f01-90db-c8e8fde502ce</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Aspire integration packages provisioning the local infrastructure (issue #17).
      Versions are pinned to the AppHost's Aspire version (13.4.2, see the SDK above) so the
      resource graph stays consistent. The Keycloak integration only ships as a preview at
      this Aspire version, hence the -preview suffix on that package alone.
    -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.4.2" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" Version="13.4.2" />
    <PackageReference Include="Aspire.Hosting.Keycloak" Version="13.4.2-preview.1.26303.6" />
    <PackageReference Include="Scalar.Aspire" Version="0.10.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The gateway/BFF host the app model orchestrates (#21); generates Projects.Roomy_Gateway. -->
    <ProjectReference Include="../gateway/Roomy.Gateway.csproj" />
    <!-- The identity context service (001); generates Projects.Roomy_Identity_Api. -->
    <ProjectReference Include="../identity-api/Roomy.Identity.Api.csproj" />
    <!-- The organization context service (002); generates Projects.Roomy_Organization_Api. -->
    <ProjectReference Include="../organization-api/Roomy.Organization.Api.csproj" />
    <!-- The attendance context service (003, Core); generates Projects.Roomy_Attendance_Api. -->
    <ProjectReference Include="../attendance-api/Roomy.Attendance.Api.csproj" />
    <!-- The shared schema-rollout runner (ADR-0033); generates Projects.Roomy_DbMigrator. -->
    <ProjectReference Include="../db-migrator/Roomy.DbMigrator.csproj" />
  </ItemGroup>

</Project>
