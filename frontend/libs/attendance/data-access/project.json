{
  "name": "attendance-data-access",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "frontend/libs/attendance/data-access/src",
  "prefix": "roomy",
  "projectType": "library",
  "tags": ["type:data-access", "context:attendance"],
  "targets": {
    "generate-client": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ng-openapi-gen --config frontend/libs/attendance/data-access/ng-openapi-gen.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/libs/attendance/data-access"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    }
  }
}
