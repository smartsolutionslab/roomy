{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "paths": {
      "@roomy/util": ["./frontend/libs/shared/util/src/index.ts"],
      "@roomy/identity-api": ["./frontend/libs/identity/api/src/index.ts"],
      "@roomy/identity-feature": ["./frontend/libs/identity/feature/src/index.ts"],
      "@roomy/shared-data-access": ["./frontend/libs/shared/data-access/src/index.ts"],
      "@roomy/shared-ui": ["./frontend/libs/shared/ui/src/index.ts"],
      "@roomy/organization-api": ["./frontend/libs/organization/api/src/index.ts"],
      "@roomy/shared-feature": ["./frontend/libs/shared/feature/src/index.ts"],
      "@roomy/organization-feature": ["./frontend/libs/organization/feature/src/index.ts"],
      "@roomy/attendance-api": ["./frontend/libs/attendance/api/src/index.ts"],
      "@roomy/attendance-feature": ["./frontend/libs/attendance/feature/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
