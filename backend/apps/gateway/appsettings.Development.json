{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Keycloak": {
      "RequireHttpsMetadata": false
    }
  },
  "ReverseProxy": {
    "Routes": {
      "spa": {
        "ClusterId": "web-dev-server",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "web-dev-server": {
        "Destinations": {
          "dev-server": {
            "Address": "http://127.0.0.1:4200/"
          }
        }
      }
    }
  }
}
