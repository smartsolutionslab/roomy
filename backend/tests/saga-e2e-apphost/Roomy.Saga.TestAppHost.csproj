<Project Sdk="Aspire.AppHost.Sdk/13.4.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SmartSolutionsLab.Roomy.Saga.TestAppHost</RootNamespace>
    <AssemblyName>Roomy.Saga.TestAppHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The full backing stack the provisioning-saga e2e needs: Postgres (per-service DBs), RabbitMQ
         (the cross-service transport), and Keycloak (real credential provider). Pinned to the AppHost's
         Aspire version, mirroring apps/apphost. -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
  </ItemGroup>

  <ItemGroup>
    <!-- The saga participants + the schema-rollout runner; generate the Projects.* metadata the host
         model references. attendance-api is included because it is a second consumer of EmployeeHired,
         so the stack exercises the per-service-queue fan-out (#189); no gateway/web. -->
    <ProjectReference Include="../../apps/identity-api/Roomy.Identity.Api.csproj" />
    <ProjectReference Include="../../apps/organization-api/Roomy.Organization.Api.csproj" />
    <ProjectReference Include="../../apps/attendance-api/Roomy.Attendance.Api.csproj" />
    <ProjectReference Include="../../apps/db-migrator/Roomy.DbMigrator.csproj" />
  </ItemGroup>

</Project>
