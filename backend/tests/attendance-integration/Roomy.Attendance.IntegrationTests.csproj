<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartSolutionsLab.Roomy.Attendance.IntegrationTests</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Attendance.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../libs/attendance/domain/Roomy.Attendance.Domain.csproj" />
    <ProjectReference Include="../../libs/attendance/infrastructure/Roomy.Attendance.Infrastructure.csproj" />
    <!-- The shared event store: JsonEventSerializer + the registry the attendance events round-trip through. -->
    <ProjectReference Include="../../libs/infrastructure-persistence/src/Roomy.Infrastructure.Persistence.csproj" />
    <!-- The minimal Aspire app host the testing builder boots as an entry point: Postgres only. -->
    <ProjectReference Include="../attendance-integration-apphost/Roomy.Attendance.TestAppHost.csproj" />
    <!-- The host under test — its POST /reservations contract is exercised in-process. -->
    <ProjectReference Include="../../apps/attendance-api/Roomy.Attendance.Api.csproj" />
    <ProjectReference Include="..\test-support\Roomy.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Stands up a real PostgreSQL through the same Aspire resource model the app host uses, so the
      event-store append/read and the (stream_id, version) optimistic-concurrency constraint are
      verified against the actual provider rather than a SQLite stand-in. Needs Docker — available on
      the CI ubuntu-latest runner.
    -->
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- WebApplicationFactory, to boot the attendance host in-process for the POST /reservations test. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
