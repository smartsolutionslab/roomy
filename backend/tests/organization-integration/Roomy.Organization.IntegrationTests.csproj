<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartSolutionsLab.Roomy.Organization.IntegrationTests</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Organization.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../libs/organization/infrastructure/Roomy.Organization.Infrastructure.csproj" />
    <!-- The host under test — booted in-process for the office endpoint tests. -->
    <ProjectReference Include="../../apps/organization-api/Roomy.Organization.Api.csproj" />
    <!-- The minimal Aspire app host the testing builder boots as the entry point: Postgres + the
         organization database, so the EF mapping is verified against the real provider. -->
    <ProjectReference Include="../organization-integration-apphost/Roomy.Organization.TestAppHost.csproj" />
    <ProjectReference Include="..\test-support\Roomy.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Stands up a real PostgreSQL through the same Aspire resource model the app host uses, so the
         EF mapping, value converters, the owned Room collection, and unique indexes are verified
         against the actual provider. Needs Docker — available on the CI ubuntu-latest runner. -->
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- WebApplicationFactory, to boot the organization host in-process for the office endpoint tests. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- A broker-less in-memory Wolverine runtime supplies a real IMessageBus + IDbContextOutbox for the
         outbox adapter's transaction-ownership test; the real DbContext transaction comes from Postgres. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
