<Project Sdk="Aspire.AppHost.Sdk/13.4.2">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SmartSolutionsLab.Roomy.EventStore.TestAppHost</RootNamespace>
    <AssemblyName>Roomy.EventStore.TestAppHost</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only Postgres: the event store's concurrency-race test needs the real provider's unique-index
         violation (SQLSTATE 23505), which SQLite cannot emit (#67). -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

</Project>
