<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartSolutionsLab.Roomy.Infrastructure.Persistence</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Infrastructure.Persistence</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../application-contracts/src/Roomy.Application.Contracts.csproj" />
    <ProjectReference Include="../../shared-kernel/src/Roomy.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF Core 10 (GA) is the persistence baseline (ADR-0012). The matching Npgsql provider for
      EF 10 is the GA 10.0.x line; the 11.x provider targets the EF 11 preview (net11.0) and is
      deliberately not used here.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

</Project>
