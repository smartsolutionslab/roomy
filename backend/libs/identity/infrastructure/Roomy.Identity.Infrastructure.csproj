<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartSolutionsLab.Roomy.Identity.Infrastructure</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Identity.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../application/Roomy.Identity.Application.csproj" />
    <ProjectReference Include="../domain/Roomy.Identity.Domain.csproj" />
    <ProjectReference Include="../../shared-kernel/src/Roomy.SharedKernel.csproj" />
    <!-- The shared EF Core baseline: RoomyDbContext, snake_case naming, Npgsql registration (ADR-0012). -->
    <ProjectReference Include="../../infrastructure-persistence/src/Roomy.Infrastructure.Persistence.csproj" />
    <!-- The transactional outbox seam (ADR-0037): the shared OutboxUnitOfWork drains identity's domain
         events to the outbox here. This context's published language is mapped at this edge. -->
    <ProjectReference Include="../../infrastructure-messaging/src/Roomy.Infrastructure.Messaging.csproj" />
    <!-- This context's own published language: AdministratorGranted is mapped to its contract here (ADR-0031). -->
    <ProjectReference Include="../contracts/Roomy.Contracts.Identity.csproj" />
    <!-- Organization's published language, consumed at the messaging edge: EmployeeHired (ADR-0031). -->
    <ProjectReference Include="../../organization/contracts/Roomy.Contracts.Organization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 (GA), matching the persistence baseline. The Npgsql provider arrives transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- IHttpClientFactory, so the Keycloak adapter is registered as a pooled, resilient typed client. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

</Project>
