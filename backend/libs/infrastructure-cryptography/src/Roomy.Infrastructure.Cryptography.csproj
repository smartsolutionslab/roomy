<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartSolutionsLab.Roomy.Infrastructure.Cryptography</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Infrastructure.Cryptography</AssemblyName>
  </PropertyGroup>

  <!--
    Shared authenticated-encryption helper for the initial-credential-on-the-bus flow (ADR-0063): the
    organization edge encrypts the initial password before it is raised/published and the identity edge
    decrypts it just before the Keycloak call, so no plaintext credential is ever written to the outbox,
    the broker, or the inbox. Infrastructure (it binds a configured key ring from configuration); kept free
    of any messaging/EF dependency so it never perturbs a host's Wolverine codegen (ADR-0034).
  -->
  <ItemGroup>
    <ProjectReference Include="../../shared-kernel/src/Roomy.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
