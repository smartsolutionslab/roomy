<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartSolutionsLab.Roomy.ArchitectureTests</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.ArchitectureTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../libs/application-contracts/src/Roomy.Application.Contracts.csproj" />
    <!--
      The identity context layers (#13, CLAUDE.md): referenced so the convention-based rules
      genuinely load and inspect them. Without this the layer rules would pass vacuously for
      identity. The layers are empty today; the conventions activate as types are added.
    -->
    <ProjectReference Include="../../../libs/identity/domain/Roomy.Identity.Domain.csproj" />
    <ProjectReference Include="../../../libs/identity/application/Roomy.Identity.Application.csproj" />
    <ProjectReference Include="../../../libs/identity/infrastructure/Roomy.Identity.Infrastructure.csproj" />
    <ProjectReference Include="../../../libs/infrastructure-messaging/src/Roomy.Infrastructure.Messaging.csproj" />
    <ProjectReference Include="../../../libs/infrastructure-persistence/src/Roomy.Infrastructure.Persistence.csproj" />
    <ProjectReference Include="../../../libs/shared-kernel/src/Roomy.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
