<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartSolutionsLab.Roomy.Identity.IntegrationTests</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Identity.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../libs/identity/infrastructure/Roomy.Identity.Infrastructure.csproj" />
    <!-- The minimal test app host (Postgres only) that the Aspire testing builder boots as its entry point. -->
    <ProjectReference Include="../identity-integration-apphost/Roomy.Identity.TestAppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Stands up a real PostgreSQL through the same Aspire resource model the app host uses (#17), so
      the identity EF mapping, value converters, and unique indexes are verified against the actual
      provider rather than a SQLite stand-in. Needs Docker — available on the CI ubuntu-latest runner.
    -->
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.4.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
