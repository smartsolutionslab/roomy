<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartSolutionsLab.Roomy.Identity.IntegrationTests</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Identity.IntegrationTests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../libs/identity/infrastructure/Roomy.Identity.Infrastructure.csproj" />
    <!-- The host under test — its DefaultAdmin seeding is exercised against the real database. -->
    <ProjectReference Include="../../apps/identity-api/Roomy.Identity.Api.csproj" />
    <!-- The shared migration runner (ADR-0033); identity is its only target today, so its runner is
         verified here against the same real Postgres. Moves to a dedicated suite when more contexts join. -->
    <ProjectReference Include="../../apps/db-migrator/Roomy.DbMigrator.csproj" />
    <!-- The minimal test app hosts the Aspire testing builder boots as entry points: Postgres for the
         persistence tests, Keycloak for the admin-adapter tests. -->
    <ProjectReference Include="../identity-integration-apphost/Roomy.Identity.TestAppHost.csproj" />
    <ProjectReference Include="../identity-keycloak-apphost/Roomy.Identity.KeycloakTestAppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Stands up a real PostgreSQL through the same Aspire resource model the app host uses (#17), so
      the identity EF mapping, value converters, and unique indexes are verified against the actual
      provider rather than a SQLite stand-in. Needs Docker — available on the CI ubuntu-latest runner.
    -->
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- WebApplicationFactory, to boot the identity host in-process for the GET /account/me test. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
