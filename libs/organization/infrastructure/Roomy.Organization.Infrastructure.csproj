<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SmartSolutionsLab.Roomy.Organization.Infrastructure</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Organization.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../application/Roomy.Organization.Application.csproj" />
    <ProjectReference Include="../domain/Roomy.Organization.Domain.csproj" />
    <ProjectReference Include="../../shared-kernel/src/Roomy.SharedKernel.csproj" />
    <!-- The shared EF Core baseline: RoomyDbContext, snake_case naming, Npgsql registration (ADR-0012). -->
    <ProjectReference Include="../../infrastructure-persistence/src/Roomy.Infrastructure.Persistence.csproj" />
    <!-- The transactional outbox seam (ADR-0037) + the owned IIntegrationEvent marker; the unit of work
         drains domain events to the outbox here. This context's published language is mapped at this edge. -->
    <ProjectReference Include="../../infrastructure-messaging/src/Roomy.Infrastructure.Messaging.csproj" />
    <ProjectReference Include="../../application-contracts/src/Roomy.Application.Contracts.csproj" />
    <ProjectReference Include="../contracts/Roomy.Contracts.Organization.csproj" />
    <!-- Identity's published language, consumed at this edge (ADR-0031): the provisioning-saga acks
         UserRegistered / UserProvisioningFailed are mapped to internal commands here (008). -->
    <ProjectReference Include="../../identity/contracts/Roomy.Contracts.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core 10 (GA), matching the persistence baseline. The Npgsql provider arrives transitively. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

</Project>
