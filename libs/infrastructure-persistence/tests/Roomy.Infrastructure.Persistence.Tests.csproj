<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SmartSolutionsLab.Roomy.Infrastructure.Persistence.Tests</RootNamespace>
    <AssemblyName>SmartSolutionsLab.Roomy.Infrastructure.Persistence.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/Roomy.Infrastructure.Persistence.csproj" />
    <!-- The minimal Aspire app host (Postgres only) the testing builder boots for the concurrency-race
         test, so the unique-index 23505 path is exercised against the real provider (#67). -->
    <ProjectReference Include="../../../tests/eventstore-integration-apphost/Roomy.EventStore.TestAppHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      PostgreSQL only — no SQLite. The event store is verified against the real provider the app uses
      (ADR-0012): the append/replay, version-check, and 23505 concurrency tests run against an
      Aspire-provisioned Postgres; the pure EF-model assertions use a connection-less Npgsql context.
      Npgsql emits the SQLSTATE 23505 the unique-index race needs, which SQLite cannot.
    -->
    <PackageReference Include="Aspire.Hosting.Testing" Version="13.4.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
